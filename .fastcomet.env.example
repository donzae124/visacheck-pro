# Copy to .fastcomet.env on the VPS and fill in real values.
# chmod 600 .fastcomet.env

FTP_HOST=ftp.yourdomain.com
FTP_USER=your_cpanel_ftp_user
FTP_PASS=your_ftp_password

# Document root for https://hhcvisa.ffgpak.com
# Common patterns:
#   public_html              (main domain)
#   public_html/hhcvisa      (subdomain folder)
#   hhcvisa.ffgpak.com       (some hosts use subdomain as folder name)
FTP_REMOTE_ROOT=public_html/hhcvisa
